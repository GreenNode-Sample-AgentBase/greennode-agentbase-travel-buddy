# ===== LLM (GreenNode AIP — tạo API key tại Console → AI Platform → LLM) =====
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash

# ===== Memory (tạo Memory tại Console → AgentBase → Memory) =====
AGENTBASE_MEMORY_ID=memory-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Strategy IDs lấy từ GET /long-term-memory-strategies (hoặc console detail page)
MEMORY_STRATEGY_PREF_ID=ltms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # user-preferences (CUSTOM)
MEMORY_STRATEGY_FACTS_ID=ltms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # trip-facts (SEMANTIC)

# ===== MCP (MCP Gateway / Connector endpoint — IAM inbound) =====
MCP_TAVILY_URL=https://gw-<gateway>-93356.agentbase-gateway.aiplatform.vngcloud.vn/tavily

# ===== Chỉ cần khi CHẠY LOCAL (trên Runtime tự động inject) =====
# GREENNODE_CLIENT_ID=
# GREENNODE_CLIENT_SECRET=

# ===== Production hardening (tuỳ chọn) =====
# AGENT_API_KEY=   # đặt key này → /invocations + /api/* yêu cầu header X-API-Key (chặn người lạ xài LLM của bạn)
# DEBUG_OPS=0      # =1 chỉ khi cần op whoami (lấy token_sub cho policy) — tắt ngay sau đó
